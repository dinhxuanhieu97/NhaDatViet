APP_NAME="BDS Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Production: mysql hoặc pgsql
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bds_db
DB_USERNAME=bds
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@bds.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:3000

BDS_WEB_ORIGIN=http://localhost:3000

# Đăng nhập Google/Facebook (tuỳ chọn) — để trống thì nút đăng nhập mạng xã hội
# vẫn hiện nhưng bấm vào sẽ báo lỗi "chưa được cấu hình". Cách lấy Client ID/
# Secret: xem CLAUDE.md mục "Đăng nhập mạng xã hội (Google/Facebook)".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/social/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/auth/social/facebook/callback
